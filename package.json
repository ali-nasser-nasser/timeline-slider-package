{
    "name": "timeline-slider",
    "version": "2.1.1",
    "description": "A draggable and customizable timeline slider with specific active years.",
    "type": "module",
    "main": "dist/timeline-slider.cjs",
    "module": "dist/timeline-slider.js",
    "unpkg": "dist/timeline-slider.global.js",
    "jsdelivr": "dist/timeline-slider.global.js",
    "exports": {
        ".": {
            "import": "./dist/timeline-slider.js",
            "require": "./dist/timeline-slider.cjs"
        },
        "./css": "./css/main.css",
        "./css/main.css": "./css/main.css",
        "./package.json": "./package.json"
    },
    "files": [
        "dist/",
        "css/",
        "src/",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "keywords": [
        "timeline",
        "slider",
        "draggable"
    ],
    "author": "alinass58",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ali-nasser-nasser/timeline-slider-package.git"
    },
    "devDependencies": {
        "tsup": "^8.0.0",
        "typescript": "^6.0.3"
    }
}
